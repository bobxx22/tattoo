# Скопіюйте цей файл у .env і заповніть.

# Токен бота від @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAH...

# Кому надсилати заявки: chat id через кому (можна кілька адмінів або id групи)
# Свій id можна дізнатися в @userinfobot. Кожен адмін має спершу написати боту /start.
TELEGRAM_CHAT_IDS=111111111,222222222
